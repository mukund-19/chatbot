# ============================================================================
# BharatShop AI: Environment Configuration Template
# ============================================================================

# Server Port
PORT=3000
APP_URL="http://localhost:3000"

# AI Provider Configuration ('gemini' | 'groq' | 'local_fallback')
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-3.8-flash"

# Google Gemini API Key (Server-side secret; never exposed to browser)
GEMINI_API_KEY=""

# Groq API Key (Optional alternative provider)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Supabase Configuration (Optional - provides cloud Postgres + Auth)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Application Feature Flags & MLOps Configuration
ENABLE_DEMO_DATA=true
ENABLE_CHURN_SERVICE=true
CHURN_MODEL_VERSION="assignment3_lightgbm_v1"
CHAT_RATE_LIMIT_PER_MINUTE=60
